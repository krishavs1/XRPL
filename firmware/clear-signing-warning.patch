 #define MAX_FIELDS_PER_PAGE 8
 
+// --- Clear-signing warnings (XRPL display-metadata proof of concept) ---------
+// The stock app renders every transaction field but surfaces no risk judgment.
+// Here the device itself flags an unverified trustline issuer, the way a wallet
+// that consumed a clear-signing metadata registry would. The verified set is
+// baked in for the demo; a production app would pin a reviewed registry hash.
+#define TX_TYPE_SET_REGULAR_KEY 5
+#define TX_TYPE_TRUST_SET 20
+#define TX_TYPE_ACCOUNT_DELETE 21
+
+// Raw 20-byte account IDs (no base58/hashing needed at review time):
+// rFKWLRVzHatrpvFEvYv5xxVLsvuoXZppu (RLUSD demo issuer, testnet)
+// rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De (Ripple RLUSD)
+static const uint8_t VERIFIED_ISSUER_IDS[][XRP_ACCOUNT_SIZE] = {
+    {0x08, 0xf2, 0xff, 0x7f, 0xf0, 0x8c, 0x2f, 0x01, 0x4d, 0xa0,
+     0xf1, 0x5b, 0x1e, 0x33, 0x87, 0xff, 0x62, 0x93, 0xa1, 0x98},
+    {0xe5, 0xe9, 0x61, 0xc6, 0xa0, 0x25, 0xc9, 0x40, 0x4a, 0xa7,
+     0xb6, 0x62, 0xdd, 0x1d, 0xf9, 0x75, 0xbe, 0x75, 0xd1, 0x3e},
+};
+
+static uint8_t num_warnings;
+static const char *const WARNING_TITLE = "SECURITY WARNING";
+static const char *warning_text;
+
+static const char *const WARN_UNVERIFIED_ISSUER =
+    "Unverified issuer. Scam tokens impersonate real assets - verify the "
+    "issuer before trusting this line.";
+static const char *const WARN_ACCOUNT_DELETE =
+    "Deletes this account and sends everything it holds to the destination. "
+    "This cannot be undone.";
+static const char *const WARN_REGULAR_KEY =
+    "Hands signing control of this account to the regular key. If that key "
+    "is not yours, this is an account takeover.";
+
+static bool is_verified_issuer(const uint8_t *account_id) {
+    for (size_t i = 0; i < sizeof(VERIFIED_ISSUER_IDS) / sizeof(VERIFIED_ISSUER_IDS[0]); i++) {
+        if (memcmp(account_id, VERIFIED_ISSUER_IDS[i], XRP_ACCOUNT_SIZE) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void detect_warnings(parseResult_t *tx) {
+    num_warnings = 0;
+    warning_text = NULL;
+
+    uint16_t tx_type = 0xFFFF;
+    for (uint8_t i = 0; i < tx->num_fields; i++) {
+        field_t *f = &tx->fields[i];
+        if (f->data_type == STI_UINT16 && f->id == XRP_UINT16_TRANSACTION_TYPE) {
+            tx_type = f->data.u16;
+            break;
+        }
+    }
+
+    switch (tx_type) {
+        case TX_TYPE_TRUST_SET:
+            for (uint8_t i = 0; i < tx->num_fields; i++) {
+                field_t *f = &tx->fields[i];
+                if (f->data_type == STI_ACCOUNT && f->id == XRP_ACCOUNT_ISSUER &&
+                    f->data.account != NULL) {
+                    if (!is_verified_issuer(f->data.account->buf)) {
+                        warning_text = WARN_UNVERIFIED_ISSUER;
+                    }
+                    break;
+                }
+            }
+            break;
+        case TX_TYPE_ACCOUNT_DELETE:
+            warning_text = WARN_ACCOUNT_DELETE;
+            break;
+        case TX_TYPE_SET_REGULAR_KEY:
+            for (uint8_t i = 0; i < tx->num_fields; i++) {
+                field_t *f = &tx->fields[i];
+                if (f->data_type == STI_ACCOUNT && f->id == XRP_ACCOUNT_REGULAR_KEY) {
+                    warning_text = WARN_REGULAR_KEY;
+                    break;
+                }
+            }
+            break;
+        default:
+            break;
+    }
+
+    if (warning_text != NULL) {
+        num_warnings = 1;
+    }
+}
