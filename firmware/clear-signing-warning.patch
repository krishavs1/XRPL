@@ -102,8 +204,11 @@ void display_review_menu(parseResult_t* transaction_param,
     memset(&txFieldNameStrings, 0, sizeof(txFieldNameStrings));
     memset(&pair, 0, sizeof(pair));
 
+    // Clear-signing: surface risk warnings as the first review screen(s).
